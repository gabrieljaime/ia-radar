[Unit]
Description=AI Radar daily Telegram digest
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-radar
ExecStart=/usr/bin/flock -n /run/lock/ai-radar-digest.lock /usr/bin/docker compose run --rm radar python scripts/send_digest.py
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
