# PostgreSQL (local Docker Compose default)
DATABASE_URL=postgresql+psycopg://ai_radar:ai_radar@localhost:5432/ai_radar

# LLM provider with an OpenAI-compatible chat completions structured-output API
LLM_API_KEY=
LLM_MODEL=gpt-4.1-nano
LLM_BASE_URL=https://api.openai.com/v1
# Configure these from the provider's current pricing. Zero means "cost unknown/not configured".
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO
MAX_ARTICLE_AGE_DAYS=14
PREFILTER_MIN_SCORE=20
DEDUPE_TITLE_THRESHOLD=88
ALERT_SCORE_THRESHOLD=90
ALERT_CONFIDENCE_THRESHOLD=0.75
